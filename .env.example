# Formspree form ID (the bit after /f/ in your endpoint URL)
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical production origin. Used for canonical tags, hreflang, sitemap and
# schema. Leave as the real domain even in preview deployments.
NEXT_PUBLIC_SITE_URL=https://pujolwilkie.com

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Optional: if
# unset, no GA code loads and no cookie banner appears, since there would be
# nothing to ask consent for.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set to the literal string "true" only on the real production deployment.
# Controls: search engine indexing, the sitemap, Vercel Analytics, Google
# Analytics and the cookie banner. Everything stays off on any other
# deployment, including previews, so test traffic is never collected or
# counted and a staging copy of the site is never indexed.
ALLOW_INDEXING=false
